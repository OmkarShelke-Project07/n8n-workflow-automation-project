# ============================================
# AI Automation Workflows - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!

# ============================================
# Gmail OAuth2 Credentials
# ============================================
GMAIL_CLIENT_ID=<your-gmail-client-id>
GMAIL_CLIENT_SECRET=<your-gmail-client-secret>
GMAIL_REFRESH_TOKEN=<your-gmail-refresh-token>

# Gmail Email Address (for notifications)
NOTIFICATION_EMAIL=<your-email@example.com>

# ============================================
# Google Sheets
# ============================================
SHEET_INVOICE_DATA_ID=<invoice-tracking-sheet-id>
SHEET_LEAD_DATA_ID=<lead-data-sheet-id>
SHEET_OUTPUT_LOG_ID=<output-log-sheet-id>

# ============================================
# Google Drive
# ============================================
GOOGLE_DRIVE_FOLDER_ID=<your-drive-folder-id>

# ============================================
# OpenAI API
# ============================================
OPENAI_API_KEY=<your-openai-api-key>

# ============================================
# Pinecone Vector Database
# ============================================
PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=n8n

# ============================================
# Vapi.ai (Voice AI)
# ============================================
VAPI_ACCESS_TOKEN=<your-vapi-access-token>
VAPI_ASSISTANT_ID=<your-vapi-assistant-id>
VAPI_PHONE_NUMBER_ID=<your-vapi-phone-number-id>

# ============================================
# Facebook
# ============================================
FACEBOOK_PAGE_ID=<your-facebook-page-id>
FACEBOOK_ACCESS_TOKEN=<your-facebook-access-token>

# ============================================
# LinkedIn
# ============================================
LINKEDIN_USER_ID=<your-linkedin-user-id>
LINKEDIN_ACCESS_TOKEN=<your-linkedin-access-token>

# ============================================
# Slack
# ============================================
SLACK_USER_ID=<your-slack-user-id>
SLACK_ACCESS_TOKEN=<your-slack-access-token>

# ============================================
# AI Model Selection
# ============================================
DEFAULT_CHAT_MODEL=gpt-4.1-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
